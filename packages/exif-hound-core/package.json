{
  "name": "exif-hound-core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./desktop": {
      "types": "./dist/desktop.d.ts",
      "import": "./dist/desktop.js",
      "require": "./dist/desktop.cjs"
    },
    "./workers/exif": {
      "types": "./dist/workers/exif.d.ts",
      "import": "./dist/workers/exif.js",
      "require": "./dist/workers/exif.cjs"
    },
    "./workers/image-processing": {
      "types": "./dist/workers/image-processing.d.ts",
      "import": "./dist/workers/image-processing.js",
      "require": "./dist/workers/image-processing.cjs"
    }
  },
  "files": ["dist/**"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "test": "jest --config jest.config.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-http": "^2.8.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "@xyflow/react": "^12.12.0",
    "exif-middleware": "*",
    "exifreader": "^4.46.0",
    "image-forensics-middleware": "*",
    "image-processing-middleware": "*",
    "@tmcw/togeojson": "^7.1.2",
    "investigation-archive": "*",
    "leaflet": "^1.9.4",
    "ocr-middleware": "*",
    "workbench-workflow": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.5",
    "globals": "^16.4.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
