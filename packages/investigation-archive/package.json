{
  "name": "investigation-archive",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean --dts",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "test": "jest --config jest.config.cjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.2",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/sql.js": "^1.4.9",
    "eslint": "^9.39.5",
    "globals": "^16.4.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}