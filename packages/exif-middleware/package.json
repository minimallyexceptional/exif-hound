{
  "name": "exif-middleware",
  "version": "2.5.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean --dts --external shared-utils",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts --external shared-utils",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "exifreader": "^4.46.0",
    "geolib": "^3.3.14"
  },
  "peerDependencies": {
    "shared-utils": "*"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "shared-utils": "*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
