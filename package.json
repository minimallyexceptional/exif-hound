{
  "name": "exif-hound-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "build:apps": "turbo run build --filter=\"./apps/*\"",
    "dev": "turbo run dev",
    "dev:packages": "turbo run dev --filter=\"./packages/*\" --parallel",
    "dev:website": "turbo run dev --filter=exif-hound-website",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "tauri:dev": "turbo run tauri:dev --filter=exif-hound-desktop",
    "tauri:build": "turbo run tauri:build --filter=exif-hound-desktop",
    "website:build": "turbo run build --filter=exif-hound-website",
    "scan:electron": "node scripts/scan-electron.js"
  },
  "devDependencies": {
    "turbo": "^2.11.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.19.0"
}
