{
  "name": "exif-hound-monorepo",
  "private": true,
  "license": "MIT",
  "version": "2.5.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "build:apps": "turbo run build --filter=\"./apps/*\"",
    "release:version": "node scripts/release/set-version.mjs",
    "dev": "turbo run dev",
    "dev:packages": "turbo run dev --filter=\"./packages/*\" --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "npm test --workspaces --if-present",
    "tauri:dev": "turbo run tauri:dev --filter=exif-hound-desktop",
    "tauri:build": "turbo run tauri:build --filter=exif-hound-desktop",
    "test:scripts": "node --test 'scripts/updater/__tests__/*.test.mjs' 'scripts/release/__tests__/*.test.mjs'",
    "test:e2e": "npm run test:e2e --workspace=exif-hound-desktop",
    "scan:electron": "node scripts/scan-electron.js",
    "scan:domain-imports": "node scripts/scan-direct-domain-imports.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.11.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {}
}
