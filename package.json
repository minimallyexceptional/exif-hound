{
  "name": "exif-hound-electron",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "description": "A desktop application for viewing and analyzing EXIF data from images",
  "author": {
    "name": "Exif Hound Team"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "electron .",
    "electron:dev": "tsc -p electron/tsconfig.json && vite build && cross-env VITE_PORT=3000 vite --port 3000 & wait-on tcp:3000 && electron . --no-sandbox --disable-gpu --disable-gpu-compositing",
    "electron:build": "npm run build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.8",
    "electron-store": "^8.1.0",
    "exifreader": "^4.21.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-loading-skeleton": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/electron": "^1.4.38",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.15.3",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.exifhound.app",
    "productName": "Exif Hound",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "public/icon.ico"
    },
    "asar": false,
    "npmRebuild": false,
    "buildDependenciesFromSource": true,
    "electronDownload": {
      "cache": "./cache"
    }
  }
}
