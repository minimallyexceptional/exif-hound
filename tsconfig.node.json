{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2020",
    "outDir": "dist-electron",
    "rootDir": ".",
    "declaration": true,
    "emitDeclarationOnly": false,
    "noEmit": false
  },
  "include": ["vite.config.ts", "electron"]
}
