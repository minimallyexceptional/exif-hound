---
import Base from "../layouts/Base.astro";

const repo = "https://github.com/minimallyexceptional/exif-hound";
const releases = `${repo}/releases`;
const issues = `${repo}/issues`;

const features = [
  {
    icon: "/assets/settings.svg",
    title: "Secure analysis",
    body: "Examine image metadata entirely on your own machine. Nothing is uploaded to any server — your files never leave the device.",
    meta: "MODE: LOCAL",
  },
  {
    icon: "/assets/file.svg",
    title: "Complete EXIF detection",
    body: "Surface everything an image carries: geolocation, camera and lens settings, timestamps, software signatures, and embedded thumbnails.",
    meta: "FIELDS: ALL",
  },
  {
    icon: "/assets/tools.svg",
    title: "Batch processing",
    body: "Analyze entire folders at once. Queue hundreds of images and get a consistent, comparable report for every one of them.",
    meta: "QUEUE: ∞",
  },
  {
    icon: "/assets/clipboard.svg",
    title: "Privacy protection",
    body: "Find sensitive personal information before you share — then strip it. Publish images without broadcasting where you live.",
    meta: "SCRUB: ON",
  },
];

const readout = [
  ["FILE", "DSC_0412.NEF"],
  ["CAMERA", "NIKON Z 6II"],
  ["LENS", "24–70mm ƒ/2.8"],
  ["ISO", "400"],
  ["EXPOSURE", "1/250 · ƒ/4.0"],
  ["GPS", "47.3769° N, 8.5417° E"],
  ["DATE", "2025:10:03 14:22:07"],
  ["THUMBNAIL", "EMBEDDED — 12.4 KB"],
];
---

<Base>
  <!-- ── Header ─────────────────────────────────────────── -->
  <header>
    <div class="wrap head">
      <a href="/" class="brand" aria-label="EXIF Hound home">
        <svg width="22" height="22" viewBox="0 0 42 42" fill="none" aria-hidden="true">
          <path
            d="M21 3.5V38.5M33.3744 8.62563L8.62563 33.3744M38.5 21H3.5M33.3744 33.3744L8.62563 8.62563"
            stroke="currentColor" stroke-width="3.75" stroke-linecap="round" stroke-linejoin="round"
          />
        </svg>
        EXIF&nbsp;HOUND
      </a>
      <nav aria-label="Primary">
        <a href="#features">Features</a>
        <a href="#download">Download</a>
        <a href={repo} rel="noopener noreferrer">GitHub</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- ── Hero ───────────────────────────────────────────── -->
    <section class="hero wrap">
      <p class="tag">Open source · Free forever</p>
      <h1>See what your<br />photos are hiding.</h1>
      <p class="lede">
        EXIF Hound is a free, open-source metadata analysis tool. Reveal
        geolocation, camera settings, and timestamps in any image — all
        processed locally, so nothing ever leaves your device.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={releases} rel="noopener noreferrer">Download EXIF Hound</a>
        <a class="btn btn-ghost" href={repo} rel="noopener noreferrer">View on GitHub</a>
      </div>

      <!-- Forensic readout panel -->
      <div class="hero-grid">
        <figure class="frame">
          <div class="frame-bar" aria-hidden="true"><i></i><i></i><i></i><span>DSC_0412.NEF — metadata report</span></div>
          <img
            src="/assets/a-computer-screen-showing-a-detailed-analysis-of-image-metadata-.png"
            alt="EXIF Hound analyzing an image's metadata in detail"
            width="1024" height="640"
            loading="eager"
          />
        </figure>
        <aside class="readout" aria-label="Example metadata readout">
          <p class="tag">Reading: DSC_0412.NEF</p>
          <dl>
            {readout.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </section>

    <!-- ── Features ───────────────────────────────────────── -->
    <section id="features" class="features wrap">
      <h2>Everything an image carries,<br />brought into the light.</h2>
      <div class="grid">
        {features.map((f) => (
          <article class="card">
            <div class="card-top">
              <img src={f.icon} alt="" width="22" height="22" loading="lazy" />
              <span class="tag">{f.meta}</span>
            </div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ── Open source ────────────────────────────────────── -->
    <section id="open-source" class="oss">
      <div class="wrap oss-inner">
        <p class="tag">Free &amp; open source · Community-driven</p>
        <h2>Open source. Free. Forever.</h2>
        <p class="oss-lede">
          One version, no paywalls, no accounts, no telemetry. EXIF Hound is
          built in the open — read the code, file issues, ship a patch.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={repo} rel="noopener noreferrer">View source</a>
          <a class="btn btn-ghost" href={issues} rel="noopener noreferrer">Report an issue</a>
        </div>
      </div>
    </section>

    <!-- ── Download ───────────────────────────────────────── -->
    <section id="download" class="download wrap">
      <h2>Take control of your image data.</h2>
      <p class="lede">Grab the latest build from GitHub releases — Windows, macOS, and Linux.</p>
      <div class="platforms">
        <a class="platform" href={releases} rel="noopener noreferrer">
          <img src="/assets/windows.svg" alt="" width="28" height="28" loading="lazy" />
          <div><strong>Windows</strong><span>.exe installer</span></div>
        </a>
        <a class="platform" href={releases} rel="noopener noreferrer">
          <img src="/assets/apple.svg" alt="" width="28" height="28" loading="lazy" />
          <div><strong>macOS</strong><span>.dmg universal</span></div>
        </a>
        <a class="platform" href={releases} rel="noopener noreferrer">
          <img src="/assets/linux.svg" alt="" width="28" height="28" loading="lazy" />
          <div><strong>Linux</strong><span>AppImage / .deb</span></div>
        </a>
      </div>
    </section>
  </main>

  <!-- ── Footer ─────────────────────────────────────────── -->
  <footer>
    <div class="wrap foot">
      <div class="brand">
        <svg width="18" height="18" viewBox="0 0 42 42" fill="none" aria-hidden="true">
          <path
            d="M21 3.5V38.5M33.3744 8.62563L8.62563 33.3744M38.5 21H3.5M33.3744 33.3744L8.62563 8.62563"
            stroke="currentColor" stroke-width="3.75" stroke-linecap="round" stroke-linejoin="round"
          />
        </svg>
        EXIF&nbsp;HOUND
      </div>
      <p class="foot-meta">© 2025 EXIF Hound contributors · Free and open source</p>
      <a href={repo} rel="noopener noreferrer">github.com/minimallyexceptional/exif-hound</a>
    </div>
  </footer>
</Base>

<style>
  /* ── Header ── */
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.22em;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--accent);
  }
  nav {
    display: flex;
    gap: 1.75rem;
    font-size: 0.95rem;
  }
  nav a {
    text-decoration: none;
    color: var(--ink-dim);
    transition: color 0.15s;
  }
  nav a:hover {
    color: var(--ink);
  }

  /* ── Hero ── */
  /* Anchored sections clear the sticky header */
  #features,
  #open-source,
  #download {
    scroll-margin-top: 4.5rem;
  }

  .hero {
    padding-block: 5.5rem 5rem;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 7vw, 4.75rem);
    margin-block: 1.25rem 1.5rem;
    letter-spacing: -0.03em;
  }
  .lede {
    max-width: 42rem;
    font-size: 1.15rem;
    color: var(--ink-dim);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.8rem 1.6rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.12s, background 0.15s, border-color 0.15s;
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn-primary {
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
  }
  .btn-primary:hover {
    background: color-mix(in srgb, var(--accent) 86%, white);
  }
  .btn-ghost {
    border-color: var(--line-strong);
    color: var(--ink);
  }
  .btn-ghost:hover {
    border-color: var(--ink-dim);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: 1.25rem;
    margin-top: 4rem;
    align-items: stretch;
  }
  .frame {
    background: var(--bg-panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .frame-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .frame-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .frame-bar i:first-child {
    background: var(--accent);
  }
  .frame-bar span {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-faint);
    letter-spacing: 0.08em;
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 9;
  }

  .readout {
    background: var(--bg-raise);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1.4rem 1.5rem;
  }
  .readout dl {
    margin-top: 1rem;
    display: grid;
    gap: 0.55rem;
  }
  .readout dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px dashed var(--line);
    padding-bottom: 0.55rem;
  }
  .readout dl div:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .readout dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
  }
  .readout dd {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink);
    text-align: right;
  }

  /* ── Features ── */
  .features {
    padding-block: 5rem;
    border-top: 1px solid var(--line);
  }
  .features h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 3rem;
  }
  .card {
    background: var(--bg-raise);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1.75rem;
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.4rem;
  }
  .card-top img {
    filter: invert(1) brightness(1.6);
    opacity: 0.9;
  }
  .card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }
  .card p {
    color: var(--ink-dim);
    font-size: 0.98rem;
  }

  /* ── Open source ── */
  .oss {
    border-block: 1px solid var(--line);
    background:
      repeating-linear-gradient(90deg, rgba(237, 234, 227, 0.05) 0 1px, transparent 1px 72px),
      repeating-linear-gradient(0deg, rgba(237, 234, 227, 0.035) 0 1px, transparent 1px 72px),
      var(--bg-raise);
  }
  .oss-inner {
    padding-block: 4.5rem;
    text-align: center;
  }
  .oss h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-block: 1rem 1.25rem;
  }
  .oss-lede {
    max-width: 38rem;
    margin-inline: auto;
    color: var(--ink-dim);
  }
  .oss .cta-row {
    justify-content: center;
  }

  /* ── Download ── */
  .download {
    padding-block: 5rem 6rem;
    text-align: center;
  }
  .download h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .download .lede {
    margin: 1rem auto 0;
  }
  .platforms {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 3rem;
  }
  .platform {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.4rem 1.5rem;
    background: var(--bg-raise);
    border: 1px solid var(--line);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }
  .platform:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .platform strong {
    display: block;
    font-size: 1.05rem;
  }
  .platform span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
  }

  /* ── Footer ── */
  footer {
    border-top: 1px solid var(--line);
    padding-block: 2.5rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .foot .brand {
    font-size: 0.75rem;
  }
  .foot-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
  }
  .foot > a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-dim);
    text-decoration: none;
  }
  .foot > a:hover {
    color: var(--ink);
  }

  /* ── Responsive ── */
  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .platforms {
      grid-template-columns: 1fr;
    }
    nav {
      gap: 1.1rem;
      font-size: 0.88rem;
    }
    .hero {
      padding-block: 4rem;
    }
  }
</style>