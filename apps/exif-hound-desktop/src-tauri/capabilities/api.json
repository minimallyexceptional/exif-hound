{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "api",
  "description": "Capabilities for the Tauri API",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "core:window:allow-set-title",
    "dialog:default",
    "http:default",
    "http:allow-fetch",
    "http:allow-fetch-cancel",
    "http:allow-fetch-read-body",
    "http:allow-fetch-send",
    {
      "identifier": "http:default",
      "allow": [
        "http://localhost:3000/api/*",
        "https://exifhound.com/api/*"
      ]
    }
  ]
} 