{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test:e2e": {
      "cache": false
    },
    "build": {
      "env": ["EXIFHOUND_UPDATE_CHANNEL", "EXIFHOUND_FEATURES"]
    },
    "tauri:build": {
      "cache": false,
      "env": [
        "EXIFHOUND_UPDATE_CHANNEL",
        "EXIFHOUND_FEATURES",
        "TAURI_BUNDLES",
        "TAURI_TARGET"
      ],
      "passThroughEnv": [
        "APPLE_ID",
        "APPLE_PASSWORD",
        "APPLE_SIGNING_IDENTITY",
        "APPLE_TEAM_ID",
        "TAURI_SIGNING_PRIVATE_KEY",
        "TAURI_SIGNING_PRIVATE_KEY_PASSWORD"
      ]
    }
  }
}
